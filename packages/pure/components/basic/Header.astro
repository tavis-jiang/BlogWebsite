---
import config from 'virtual:config'

import { Icon } from '../user'
---

<header-component
  class='group sticky top-4 z-50 max-md:z-30 mb-12 flex items-center justify-between rounded-xl border border-transparent max-sm:py-1 sm:rounded-2xl'
>
  <a
    class='z-30 text-xl font-medium group-[.not-top]:ms-2 sm:group-[.not-top]:ms-3'
    style='transition:margin-inline 0.3s'
    href='/'
    aria-label='Brand'>{config.title}</a
  >

  <div class='flex items-center gap-x-2'>
    {/* Menu links */}
    <div
      id='headerExpandContent'
      class='end-0 start-0 top-12 grid border border-transparent group-[.not-top]:rounded-xl group-[.expanded]:opacity-100 dark:group-[.expanded.not-top]:bg-muted max-sm:absolute max-sm:opacity-0 max-sm:group-[.not-top]:border-border max-sm:group-[.expanded.not-top]:bg-background max-sm:group-[.not-top]:px-4 max-sm:group-[.not-top]:py-2 sm:grid-rows-1'
    >
      <div class='flex flex-col items-center justify-center overflow-hidden sm:flex-row'>
        {
          config.header.menu.map((item) => (
            <a
              href={item.link}
              class='w-full flex-none grow py-2 text-right font-medium transition-none hover:text-primary sm:w-fit sm:px-3'
              aria-label='Nav menu item'
              data-astro-prefetch
              data-nav-item
            >
              {item.title}
            </a>
          ))
        }
        <div class='flex w-full grow flex-row justify-end gap-x-3 sm:w-fit sm:gap-x-5'>
          <a class='px-1 py-2 transition-none sm:px-2' href='/search' title='Search' data-search-link>
            <span class='sr-only'>Search</span>
            <Icon name='search' class='size-5' />
          </a>
        </div>
      </div>
    </div>

    {/* buttons */}
    <div class='z-30 flex gap-x-4 group-[.not-top]:gap-x-2' style='transition:gap 0.3s'>
      <button
        id='toggleLang'
        class='box-content rounded-md border px-1.5 py-1 text-xs font-medium transition-colors hover:bg-border sm:group-[.not-top]:rounded-xl'
        aria-label='Switch language'
        title='Switch language'
      >
        <span class='lang-text'>中</span>
      </button>
      <button
        id='toggleDarkMode'
        class='group/dark box-content size-5 rounded-md border p-1.5 transition-colors hover:bg-border sm:group-[.not-top]:rounded-xl'
      >
        <span class='sr-only'>Dark Theme</span>
        <Icon class='system size-5 group-hover/dark:text-primary' name='computer' />
        <Icon class='light hidden size-5 group-hover/dark:text-primary' name='sun' />
        <Icon class='dark hidden size-5 group-hover/dark:text-primary' name='moon' />
      </button>
      <button
        id='toggleMenu'
        class='rounded-md border p-1.5 transition-colors hover:bg-border sm:hidden sm:group-[.not-top]:rounded-xl'
      >
        <span class='sr-only'>Menu</span>
        <Icon class='size-5' name='menu' />
      </button>
    </div>
  </div>
</header-component>

<script is:inline>
  // === i18n translations (embedded for fast initial load) ===
  const I18N = {
    en: {
      'Blog': 'Blog',
      'Projects': 'Projects',
      'Links': 'Links',
      'About': 'About',
      'Search': 'Search',
      'Menu': 'Menu',
      'Site Policy': 'Site Policy',
      'Powered by Astro & Pure theme': 'Astro & Pure theme powered',
      'Posts': 'Posts',
      'Education': 'Education',
      'Skills': 'Skills',
      'Languages': 'Languages',
      'Frontend': 'Frontend',
      'Backend': 'Backend',
      'More about me': 'More about me',
      'More posts': 'More posts',
      'Get Template': 'Get Template',
      'Tags': 'Tags',
      'Archives': 'Archives',
      'Terms': 'Terms',
      'Home': 'Home'
    },
    zh: {
      'Blog': '博客',
      'Projects': '项目',
      'Links': '友链',
      'About': '关于',
      'Search': '搜索',
      'Menu': '菜单',
      'Site Policy': '站点政策',
      'Powered by Astro & Pure theme': '由 Astro & Pure 主题驱动',
      'Posts': '文章',
      'Education': '教育背景',
      'Skills': '技能',
      'Languages': '编程语言',
      'Frontend': '前端',
      'Backend': '后端',
      'More about me': '了解更多',
      'More posts': '更多文章',
      'Get Template': '获取模板',
      'Tags': '标签',
      'Archives': '归档',
      'Terms': '条款',
      'Home': '首页'
    }
  }

  function getLang() {
    return localStorage.getItem('site-lang') || 'en'
  }

  function translateAll(lang) {
    // Translate nav menu items
    document.querySelectorAll('[data-nav-item]').forEach(el => {
      const orig = el.getAttribute('data-nav-original')
      if (orig) {
        const translated = (I18N[lang] && I18N[lang][orig]) || orig
        // Preserve whitespace around text for layout
        el.childNodes.forEach(node => {
          if (node.nodeType === 3) { // Text node
            node.textContent = ' ' + translated + ' '
          }
        })
      }
    })

    // Translate search link title
    const searchLink = document.querySelector('[data-search-link]')
    if (searchLink) {
      if (lang === 'zh') {
        searchLink.setAttribute('title', I18N.zh['Search'])
      } else {
        searchLink.setAttribute('title', I18N.en['Search'])
      }
      // Also update sr-only span
      const srOnly = searchLink.querySelector('.sr-only')
      if (srOnly) {
        srOnly.textContent = lang === 'zh' ? I18N.zh['Search'] : I18N.en['Search']
      }
    }

    // Translate elements with data-i18n-key
    document.querySelectorAll('[data-i18n-key]').forEach(el => {
      const key = el.getAttribute('data-i18n-key')
      if (key && key in I18N.en) {
        const text = lang === 'zh' ? (I18N.zh[key] || I18N.en[key]) : I18N.en[key]
        // If element has no children or only text children, update textContent
        if (!el.children.length) {
          el.textContent = text
        } else {
          // For elements with child elements (like Button), find and update the text-bearing child
          // Look for <p> or <span> children that match the original English text
          el.querySelectorAll('p, span').forEach(child => {
            const trimmed = child.textContent?.trim()
            if (trimmed && I18N.en[key]?.includes(trimmed)) {
              child.textContent = text
            }
          })
        }
      }
    })

    // Update html lang
    document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en-US'

    // Update toggle button text
    const langBtn = document.getElementById('toggleLang')
    if (langBtn) {
      const span = langBtn.querySelector('.lang-text')
      if (span) span.textContent = lang === 'zh' ? 'EN' : '中'
    }
  }

  // === Save original text on nav items ===
  document.querySelectorAll('[data-nav-item]').forEach(el => {
    if (!el.hasAttribute('data-nav-original')) {
      el.setAttribute('data-nav-original', el.textContent.trim())
    }
  })

  // Expose for module script access
  window.__translateAll = translateAll

  // === Initialize language on page load ===
  const currentLang = getLang()
  translateAll(currentLang)

  // === Dark mode init (original) ===
  const toggleDarkModeElement = document.getElementById('toggleDarkMode')
  if (toggleDarkModeElement) {
    toggleDarkModeElement.dataset.theme = localStorage.getItem('theme') || 'system'
  }
</script>
<script>
  import { setTheme, showToast } from '../../utils'

  class HeaderComponent extends HTMLElement {
    connectedCallback() {
      // Header scroll behavior
      let preScrollY = window.scrollY
      this.classList.toggle('not-top', preScrollY > 20)
      window.addEventListener('scroll', () => {
        this.classList.toggle('not-top', window.scrollY > 20)
        this.dataset.show = (window.scrollY < 350 || window.scrollY < preScrollY).toString()
        preScrollY = window.scrollY
      })

      // Language toggle
      const langBtn = this.querySelector('#toggleLang') as HTMLElement
      langBtn?.addEventListener('click', () => {
        // Re-read translateAll from the inline script scope
        // It's globally available since is:inline scripts run in global scope
        const current = localStorage.getItem('site-lang') || 'en'
        const next = current === 'en' ? 'zh' : 'en'
        localStorage.setItem('site-lang', next)

        // Call the global translateAll function (defined in inline script)
        if (typeof window.__translateAll === 'function') {
          window.__translateAll(next)
        }

        // Dispatch event for other scripts
        window.dispatchEvent(new CustomEvent('lang-change', { detail: { lang: next } }))
        showToast({ message: next === 'zh' ? '已切换为中文' : 'Switched to English' })
      })

      // Dark Mode
      const darkModeBtn = this.querySelector('#toggleDarkMode') as HTMLElement
      darkModeBtn.addEventListener('click', () => {
        const newTheme = setTheme(undefined, true)
        darkModeBtn.dataset.theme = newTheme
        showToast({ message: `Set theme to ${newTheme}` })
      })

      // Menu
      this.querySelector('#toggleMenu')?.addEventListener('click', () => {
        this.classList.toggle('expanded')
      })
    }
  }

  customElements.define('header-component', HeaderComponent)
</script>

<style>
  header-component {
    transition:
      padding 0.3s,
      transform 0.3s,
      margin-inline 0.3s,
      border 0.15s,
      background-color 0.15s;

    &.not-top {
      --un-border-opacity: 1;
      border-color: hsl(var(--border) / var(--un-border-opacity));
      --un-bg-opacity: 1;
      background-color: hsl(var(--background) / var(--un-bg-opacity));
      padding-left: 0.375rem;
      padding-right: 0.375rem;
      box-shadow:
        rgb(255, 255, 255) 0px 0px 0px 0px,
        rgba(24, 24, 27, 0.08) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.08) 0px 4px 6px -4px;
    }
    &[data-show='false']:not(.expanded) {
      transform: translateY(-5rem);
    }
  }
  @media (min-width: 800px) {
    header-component.not-top {
      margin-inline: 8%;
    }
  }
  :global(.dark) header-component.not-top {
    background-color: hsl(var(--muted) / var(--un-bg-opacity));
  }

  /* Language toggle */
  #toggleLang {
    line-height: 1.25;
    min-width: 2rem;
    text-align: center;
  }

  /* header menu */
  @media (max-width: 640px) {
    #headerExpandContent {
      grid-template-rows: 0fr;
      transition:
        opacity 0.3s,
        padding 0.3s,
        border-color 0.15s,
        grid-template-rows 0.3s;
    }
    .expanded #headerExpandContent {
      grid-template-rows: 1fr;
    }
    .expanded.not-top #headerExpandContent {
      box-shadow:
        rgb(255, 255, 255) 0px 0px 0px 0px,
        rgba(24, 24, 27, 0.08) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.08) 0px 4px 6px -4px;
    }

    /* header component after */
    header-component #headerExpandContent::after {
      box-sizing: content-box;
      content: '';
      position: absolute;
      inset-inline: calc(-1rem - 1px);
      bottom: 0;
      top: -5rem;
      z-index: -1;
      transition: 0.3s;
      visibility: hidden;
      opacity: 0;
      border-bottom: 1px solid transparent;
    }
    header-component:not(.not-top) #headerExpandContent::after {
      visibility: visible;
      bottom: -1rem;
      opacity: 1;
      background-color: hsl(var(--muted) / var(--un-bg-opacity, 1));
      border-bottom-color: hsl(var(--border) / var(--un-border-opacity, 1));
    }
  }

  /* dark light mode toggle */
  #toggleDarkMode {
    &[data-theme='dark'] {
      & .system {
        display: none;
      }
      & .dark {
        display: block;
      }
    }
    &[data-theme='light'] {
      & .system {
        display: none;
      }
      .light {
        display: block;
      }
    }
  }
</style>
