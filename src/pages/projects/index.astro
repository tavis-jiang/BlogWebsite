---
import { Image } from 'astro:assets'

import { Button, Collapse, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.jpg'
import wechat from '@/assets/wechat-qrcode.jpg'

const headings = [
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'learnings', text: 'Learnings' },
  { depth: 2, slug: 'others', text: 'Others' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} view>
  {/* About */}
  <div class='not-prose flex justify-center'>
    <a
      href='https://github.com/tavis-jiang' target='_blank'
      class='flex items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
    >
      <span class='size-2 rounded-full bg-green-400'></span>
      <p class='font-medium text-muted-foreground'>Check out my GitHub</p>
    </a>
  </div>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/tavis-jiang'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <p>
    If you think it would be useful or interesting to collaborate on a project, you can donate to
    support my work or contact me to discuss a project.
  </p>
  <Button title='Checkout sponsorship' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: '🌐 Personal Website',
        description: 'My personal blog built with Astro and Pure theme',
        links: [
          { type: 'github', href: 'https://github.com/tavis-jiang/BlogWebsite' },
          { type: 'site', href: 'https://tavisj.top' }
        ]
      },
      {
        name: '📝 Obsidian Notes',
        description: 'My knowledge base and learning notes',
        links: [
          { type: 'github', href: 'https://github.com/tavis-jiang/obsidian_notes' }
        ]
      }
    ]}
  />
  <Collapse title='More projects'>
    <ProjectSection
      projects={[
        {
          name: '🔧 Shell Scripts',
          description: 'Useful shell scripts for daily workflows',
          links: [
            { type: 'github', href: 'https://github.com/tavis-jiang' }
          ]
        }
      ]}
    />
  </Collapse>

  <h2 id='learnings'>Learnings</h2>
  <ProjectSection
    class='my-2'
    projects={[
      {
        name: 'Obsidian Notes',
        description: 'Learning notes, code snippets and experiences',
        links: [
          { type: 'github', href: 'https://github.com/tavis-jiang/obsidian_notes' }
        ]
      }
    ]}
  />

  <h2 id='others'>Others</h2>
  <ProjectSection
    projects={[
      {
        name: 'Tavis Jiang',
        description: 'My GitHub Profile - Check out all my projects',
        links: [
          { type: 'github', href: 'https://github.com/tavis-jiang' }
        ]
      }
    ]}
  />

  <h2 id='sponsorship'>Sponsorship</h2>
  <p>If you find my work helpful, you can sponsor me via WeChat or Alipay:</p>
  <Sponsorship
    methods={[
      { name: 'WeChat', icon: 'wechat-pay', image: wechat },
      { name: 'Alipay', icon: 'alipay', image: alipay }
    ]}
  />
  <p>Thanks for your support!</p>
</PageLayout>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>
